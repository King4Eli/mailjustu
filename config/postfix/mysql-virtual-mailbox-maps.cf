# Provisioned into the postfix_config volume by setup/postfix-setup.sh,
# which substitutes ${DB_*} from ./.env/api.env (Postfix mysql maps don't
# support %{env:...} expansion themselves, so this happens before writing).
hosts = ${DB_HOST}
user = ${DB_USER}
password = ${DB_PASSWORD}
dbname = ${DB_NAME}
query = SELECT 1 FROM virtual_users WHERE email='%s'
