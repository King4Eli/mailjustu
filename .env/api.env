PORT=4000

# Must match ./.env/mysql.env
DB_HOST=global_mysql
DB_PORT=3306
DB_USER=mail_justu_user
DB_PASSWORD=mail_justu_password1
DB_NAME=mail_justu

# 31993, not 993: containers talk to Dovecot's actual internal listener
# (see ./volumes/dovecot/vendor.d/rootless.conf); 993 is only the
# host-published port for external clients.
IMAP_HOST=mail_justu_dovecot
IMAP_PORT=31993

SMTP_HOST=mail_justu_postfix
SMTP_PORT=25

# Optional -- absent if the rspamd add-on compose file isn't included.
RSPAMD_HOST=mail_justu_rspamd
RSPAMD_PORT=11334
# Must match ./volumes/rspamd/local.d/worker-controller.inc
RSPAMD_CONTROLLER_PASSWORD=change_me

# Shared secret the admin dashboard sends as a Bearer token. Never expose
# this as a VITE_ variable -- it must not end up in browser JS.
ADMIN_TOKEN=change_me_admin_token

SESSION_TTL_MINUTES=120

# Dev origins for the two frontends; comma-separated.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
