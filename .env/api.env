PORT=4000

# Must match ./.env/mysql.env
DB_HOST=global_mysql
DB_PORT=3306
DB_USER=mail_justu_user
DB_PASSWORD=mail_justu_password1
DB_NAME=mail_justu

# 31993, not 993: containers talk to Dovecot's actual internal listener
# (see ./volumes/dovecot/vendor.d/rootless.conf); 993 is only the
# host-published port for external clients.
IMAP_HOST=mail_justu_dovecot
IMAP_PORT=31993

SMTP_HOST=mail_justu_postfix
SMTP_PORT=25

# Optional -- absent if the rspamd add-on compose file isn't included.
RSPAMD_HOST=mail_justu_rspamd
RSPAMD_PORT=11334
# Must match ./volumes/rspamd/local.d/worker-controller.inc
RSPAMD_CONTROLLER_PASSWORD=change_me

# Dovecot's doveadm HTTP API -- used to report per-mailbox storage usage
# in the admin dashboard (doveadm mailboxStatus vsize). Must match
# DOVEADM_PASSWORD in ./.env/dovecot.env.
DOVEADM_HOST=mail_justu_dovecot
DOVEADM_PORT=8080
DOVEADM_PASSWORD=767a1898fa53d04b00a63d56ef9f806e9fbc40c4487f070f

# Comma-separated emails that get full admin access (all domains,
# mailboxes, aliases, plus Services/health/stats) once they log in with
# their real mailbox password -- same login as webUI, just a privileged
# account. Anyone else with virtual_users.is_admin set is a *domain*
# admin instead: scoped to their own domain, never sees Services.
SUPER_ADMIN_EMAILS=admin@mail.example.com

SESSION_TTL_MINUTES=120

# Dev origins for the two frontends; comma-separated.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Global defaults for new domains -- a domain's own max_mailboxes /
# max_aliases_per_mailbox / quota_mb (set via the admin dashboard)
# overrides these. Leave a value unset/0 for "no limit".
MAX_MAILBOXES_PER_DOMAIN=50
MAX_ALIASES_PER_MAILBOX=5
# Must match the 1024M fallback in ./volumes/dovecot/conf.d/quota.conf and
# auth-sql.conf's userdb query -- real enforcement happens in Dovecot, not
# here; this is just what the admin dashboard shows as the default.
DEFAULT_MAILBOX_QUOTA_MB=1024

# Used to generate copy-pasteable DNS records (MX/A/SPF/DMARC) when a
# domain is added in the admin dashboard. Placeholders until you put your
# real mail hostname / public IP here.
MAIL_HOSTNAME=mail.example.com
MAIL_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP
