PORT=80

# >>> change: DB creds
DB_HOST=global_mysql
DB_PORT=3306
DB_USER=mail_justu_user
DB_PASSWORD=mail_justu_password1
DB_NAME=mail_justu

# 31993 = Dovecot's internal listener; 993 is the host-published port
IMAP_HOST=mail_justu_dovecot
IMAP_PORT=31993

SMTP_HOST=mail_justu_postfix
SMTP_PORT=25

# Optional -- only used if the rspamd overlay is included
RSPAMD_HOST=mail_justu_rspamd
RSPAMD_PORT=11334
# >>> change: regenerate for a new server -- see setup/rspamd-setup.sh
RSPAMD_CONTROLLER_PASSWORD=c7983a54c8bf5bdfb153e26f

# doveadm HTTP API for per-mailbox storage usage; password lives in .env/dovecot.env
DOVEADM_HOST=mail_justu_dovecot
DOVEADM_PORT=8080

# ManageSieve port for mail filter rules (see lib/api/sieve.ts)
MANAGESIEVE_PORT=34190

# Full-access super admin login; can be a comma-separated list
# >>> change: super admin email + seed password (change after first login)
SUPER_ADMIN_EMAILS=admin@mail.mailjustu.local
SUPER_ADMIN_PASSWORD=6ed25d00ee384f50b860da3emx

SESSION_TTL_MINUTES=120

# Login brute-force throttle (per mailbox + per IP)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Messages list page size
MESSAGE_LIST_PAGE_SIZE=30
# Max results for a server-side search
SEARCH_RESULT_LIMIT=100

# Background pollers (see lib/api/scheduler.ts)
SCHEDULED_SEND_POLL_SECONDS=5
SNOOZE_POLL_SECONDS=60

# Defaults for new domains; 0/unset = no limit
MAX_MAILBOXES_PER_DOMAIN=50
MAX_ALIASES_PER_MAILBOX=5
MAX_FOLDERS_PER_MAILBOX=30
MAX_ATTACHMENTS_PER_MESSAGE=10
MAX_ATTACHMENT_SIZE_MB=25
# Must match dovecot_config's quota.conf fallback
DEFAULT_MAILBOX_QUOTA_MB=1024

# >>> change: public IP (used for generated DNS records)
MAIL_PUBLIC_IP=192.168.0.1

# Local-dev fallback; prod overrides via deploy.json's ssh command.
APP_VERSION=dev.00

# DKIM is per-domain now (see bigapp/lib/api/dkim.ts) -- nothing here.
