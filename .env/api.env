PORT=80

# >>> change: DB creds
DB_HOST=global_mysql
DB_PORT=3306
DB_USER=mail_justu_user
DB_PASSWORD=mail_justu_password1
DB_NAME=mail_justu

# 31993, not 993: containers talk to Dovecot's actual internal listener
# (see /etc/dovecot/vendor.d/rootless.conf in the dovecot_config volume); 993 is only the
# host-published port for external clients.
IMAP_HOST=mail_justu_dovecot
IMAP_PORT=31993

SMTP_HOST=mail_justu_postfix
SMTP_PORT=25

# Optional -- absent if the rspamd add-on compose file isn't included.
RSPAMD_HOST=mail_justu_rspamd
RSPAMD_PORT=11334
# >>> change: still the unset placeholder -- must match
# /etc/rspamd/local.d/worker-controller.inc in the rspamd_config volume
RSPAMD_CONTROLLER_PASSWORD=change_me

# Dovecot's doveadm HTTP API -- used to report per-mailbox storage usage
# in the admin dashboard (doveadm mailboxStatus vsize).
# Don't edit this value here -- it's synced from .env/dovecot.env by
# setup.sh on every run. Change the password there instead.
DOVEADM_HOST=mail_justu_dovecot
DOVEADM_PORT=8080
DOVEADM_PASSWORD=767a1898fa53d04b00a63d56ef9f806e9fbc40c4487f070f

# The one super admin: full access (all domains, mailboxes, aliases, plus
# Services/health/stats), logs in with their real mailbox password same as
# webUI. Anyone else with virtual_users.is_admin set is a *domain* admin
# instead: scoped to their own domain, never sees Services. Can hold a
# comma-separated list if you ever want more than one, but keep it to one.
# >>> change: super admin email
SUPER_ADMIN_EMAILS=admin@suyoapp.com
# >>> change: seed password for --bootstrap-admin, log in and change it after first use
SUPER_ADMIN_PASSWORD=6ed25d00ee384f50b860da3e

SESSION_TTL_MINUTES=120

# Global defaults for new domains -- a domain's own max_mailboxes /
# max_aliases_per_mailbox / quota_mb (set via the admin dashboard)
# overrides these. Leave a value unset/0 for "no limit".
MAX_MAILBOXES_PER_DOMAIN=50
MAX_ALIASES_PER_MAILBOX=5
# Custom IMAP folders per mailbox (webUI's "New folder") -- doesn't count
# the 6 standard folders (Inbox/Sent/Drafts/Spam/Trash/Archive). Leave
# unset/0 for "no limit".
MAX_FOLDERS_PER_MAILBOX=30
# Compose-time attachments (webUI send/drafts, multer). Both are enforced
# server-side; exceeding either now returns a clear 400 instead of a
# generic 500 (see api/src/routes/mail.js's uploadAttachments).
MAX_ATTACHMENTS_PER_MESSAGE=10
MAX_ATTACHMENT_SIZE_MB=25
# Must match the 1024M fallback in /etc/dovecot/conf.d/quota.conf in the dovecot_config volume and
# auth-sql.conf's userdb query -- real enforcement happens in Dovecot, not
# here; this is just what the admin dashboard shows as the default.
DEFAULT_MAILBOX_QUOTA_MB=1024

# Used to generate copy-pasteable DNS records (MX/A/SPF/DMARC) when a
# domain is added in the admin dashboard.
# >>> change: server hostname
MAIL_HOSTNAME=mail.suyoapp.com
# >>> change: public IP (SPF/PTR/DNS)
MAIL_PUBLIC_IP=168.231.67.172

# Must match the selector/key in the opendkim_config volume's keys/ dir
# (see docker-compose.opendkim.yml) -- used only to render the DKIM row in
# the admin dashboard's generated DNS records, not by signing itself.
DKIM_SELECTOR=mail
DKIM_PUBLIC_KEY=v=DKIM1; h=rsa-sha256; k=rsa; 
