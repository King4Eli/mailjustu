# Vite development and preview servers
WEBUI_DEV_HOST=0.0.0.0
WEBUI_DEV_PORT=5174
WEBUI_PREVIEW_HOST=0.0.0.0
WEBUI_PREVIEW_PORT=4174

# Values prefixed with VITE_ are public and bundled into browser code.
# Never place passwords, API tokens, or Docker socket credentials here.
VITE_APP_TITLE=Mailbox
