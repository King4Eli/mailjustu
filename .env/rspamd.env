# PORT_PROXY/PORT_CONTROLLER are rspamd's own built-in {= env.X =} template
# names (used directly in its compiled-in rspamd.conf), so these are read
# correctly. The Redis address and controller password are NOT read from
# env -- see the comment in /etc/rspamd/local.d/worker-controller.inc in the rspamd_config volume
# for why -- they're hardcoded there instead; keep them in sync if changed.
PORT_PROXY=11332
PORT_CONTROLLER=11334
