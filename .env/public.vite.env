# WARNING: everything in this file ends up in the browser bundle and is
# visible to anyone who opens the site -- it is PUBLIC. Never place
# passwords, API tokens, or Docker socket credentials here.

# Shared by both apps.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_MAIL_HOST=mail.example.com

# webmail-only.
VITE_APP_TITLE=Mailbox
# Shown as an "Open admin dashboard" link for domain/super admins only.
# Relative because webmail and admin are now served from the same origin
# (see webFront/nginx.conf).
VITE_ADMIN_URL=/admin/

# admin-only.
VITE_ADMIN_TITLE=Postmaster
