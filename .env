# Auto-loaded by `docker compose` from the project dir. Only for ${...}
# interpolation in the compose files -- NOT injected into containers.
# Per-service process env lives in ./env/*.env (each service's env_file:).
#
#   APP_VERSION   -> mail_justu_server image tag (+ echoed to the server
#                    container via docker-compose.yml's environment:)
#   MAIL_HOSTNAME -> Postfix's hostname:, and the server's DNS-record
#                    generator (lib/api/dns.ts), via environment:

# >>> change: public FQDN of this mail server
MAIL_HOSTNAME=mail.example.com

# Local-dev fallback; prod overrides via deploy.json's ssh command.
APP_VERSION=dev.00
